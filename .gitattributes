# Executed by Linux
*.sh text eol=lf
*.py text eol=lf

# Windows-native scripts
*.ps1 text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Changelogs are append-mostly; auto-merge by unioning both sides.
packages/*/CHANGELOG.md merge=union

# Generated, minified catalog artifacts: regenerate instead of diffing/merging.
packages/catalog/src/models.json binary
packages/catalog/src/compat/rules.json binary

# Generated tree-sitter parser: regenerate from grammar.js (see its README.md).
crates/vendor/tree-sitter-go/src/parser.c linguist-generated

# Files whose trailing whitespace is load-bearing, so the pre-commit
# `git diff --check` pass must not flag them.
#
# This fork localizes the TUI; it does not reformat upstream sources. The
# entries below keep the vendored/copied files byte-identical to the official
# tag instead of letting a local hygiene check rewrite them.
#
# - `bazel/patches/*.patch` are unified diffs: a context line for a blank
#   target line is a single space, and stripping it produces an invalid patch
#   that fails to apply.
# - `*THIRD-PARTY-NOTICES.txt` is vendored license text carried verbatim.
# - `README.md` uses Markdown hard line breaks (two trailing spaces).
# - `*.xkb` are vendored keymap fixtures carried verbatim.
# - the list below is the upstream v18.4.10 tree as received: it carries
#   trailing whitespace and space-before-tab indents of its own.
bazel/patches/*.patch whitespace=-blank-at-eol,-blank-at-eof
*THIRD-PARTY-NOTICES.txt whitespace=-blank-at-eol,-blank-at-eof
README.md whitespace=-blank-at-eol
*.xkb whitespace=-blank-at-eol,-blank-at-eof

